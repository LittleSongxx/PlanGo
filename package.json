{
  "name": "yoyu",
  "version": "0.1.0",
  "description": "YOYU · 独立运行的真实浏览器 Agent 与可恢复 Harness",
  "main": "./out/main/index.js",
  "author": "Xiaonian",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "eval": "tsx scripts/eval.ts",
    "cli": "tsx scripts/cli.ts",
    "setup:backend": "uv sync --frozen --extra dev --python 3.12",
    "backend": "uv run --frozen python scripts/backend.py",
    "test:backend": "uv run --frozen pytest -q",
    "test:ui": "tsx scripts/check-harness-ui.ts",
    "test:transport": "tsx scripts/check-harness-transport.ts",
    "test:browser": "electron --no-sandbox scripts/browser-regression.cjs",
    "test:desktop": "electron --no-sandbox scripts/desktop-ui-smoke.cjs",
    "test:full-stack": "electron --no-sandbox scripts/full-stack-smoke.cjs",
    "check": "npm run typecheck && npm run test:ui && npm run test:transport && npm run test:share && npm run test:backend && npm run build",
    "upstream:check": "python3 scripts/sync_planora.py check",
    "test:share": "tsx scripts/check-share.ts",
    "test:independent": "uv run --frozen python scripts/check_independent.py"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@mozilla/readability": "^0.6.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^5.0.1"
  },
  "engines": {
    "node": ">=20.11"
  }
}
