# YOYU 自有配置；复制为 .env 后填写，或使用桌面设置。
LLM_PROVIDER=openai
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.0
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# 通用 OpenAI 兼容端点；提供 OPENAI_API_KEY 时优先使用这一组。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

AMAP_WEBSERVICE_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY=
XIAONIAN_CITY=上海
DATA_SOURCE=amap

# 默认自动运行本项目后端，无需 Planora 或外部数据库。
YOYU_BACKEND_URL=http://127.0.0.1:8011
YOYU_BACKEND_AUTOSTART=true
# YOYU_BACKEND_TOKEN=
# YOYU_PYTHON=/absolute/path/to/python
# YOYU_DATA_DIR=/absolute/path/to/yoyu-data
# YOYU_RUNTIME_PROFILE=desktop
