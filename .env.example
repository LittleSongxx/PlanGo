# 小念 · 环境变量（复制为 .env 后填写；.env 不进仓库）

# —— 大模型（LongCat，OpenAI 兼容）——
LONGCAT_API_KEY=ak_your_key_here
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.0

# —— 高德地图 Web 服务（有则接真实 POI/路线/天气；没有自动降级 VitaBench）——
AMAP_WEBSERVICE_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY=

# —— 数据源开关：mock | amap | enterprise ——
DATA_SOURCE=mock

# —— 默认演示城市 ——
XIAONIAN_CITY=上海

# —— 企业自定义 Adapter（DATA_SOURCE=enterprise 时用）——
ENTERPRISE_API_BASE=
ENTERPRISE_API_KEY=
