# YOYU 自有配置；复制为 .env 后填写，或使用桌面设置。
LLM_PROVIDER=openai
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.0
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# 通用 OpenAI 兼容端点；提供 OPENAI_API_KEY 时优先使用这一组。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

AMAP_WEBSERVICE_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY=
XIAONIAN_CITY=上海

# 默认连接本项目 Docker 后端；本地 SQLite 模式可将 AUTOSTART 改为 true。
YOYU_BACKEND_URL=http://127.0.0.1:8011
YOYU_BACKEND_AUTOSTART=false
# YOYU_BACKEND_TOKEN=
# npm run setup:backend 自动写入 planora conda 环境解释器路径。
# YOYU_PYTHON=/absolute/path/to/envs/planora/bin/python
# YOYU_DATA_DIR=/absolute/path/to/yoyu-data
# YOYU_RUNTIME_PROFILE=desktop

# Docker 使用本项目专属服务和数据卷；setup:backend 自动生成缺失的 token 与数据库密码。
# YOYU_POSTGRES_PASSWORD=
# YOYU_SERVICE_PORT=8011
# 连接 Docker 后端时设置 YOYU_BACKEND_AUTOSTART=false，并配置同一个 YOYU_BACKEND_TOKEN。
