# PlanGo 自有配置；复制为 .env 后填写，或使用桌面设置。
# 四家国内主流 OpenAI 兼容端点；只在桌面设置里点选也可以，无需在此填写。
PLANGO_LLM_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus-2026-05-26
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# 通用 OpenAI 兼容端点；提供 OPENAI_API_KEY 时优先使用这一组。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

AMAP_WEBSERVICE_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY=
PLANGO_CITY=重庆

# 默认连接本项目 Docker 后端；本地 SQLite 模式可将 AUTOSTART 改为 true。
PLANGO_BACKEND_URL=http://127.0.0.1:8011
PLANGO_BACKEND_AUTOSTART=false
# PLANGO_BACKEND_TOKEN=
# npm run setup:backend 自动写入 plango conda 环境解释器路径。
# PLANGO_PYTHON=/absolute/path/to/envs/plango/bin/python
# PLANGO_DATA_DIR=/absolute/path/to/plango-data
# PLANGO_RUNTIME_PROFILE=desktop

# Docker 使用本项目专属服务和数据卷；setup:backend 自动生成缺失的 token 与数据库密码。
# PLANGO_POSTGRES_PASSWORD=
# PLANGO_SERVICE_PORT=8011
# 连接 Docker 后端时设置 PLANGO_BACKEND_AUTOSTART=false，并配置同一个 PLANGO_BACKEND_TOKEN。

# 先执行受控截图能力验证，再允许每轮最多一次的只读视觉理解；不能代替提交审批。
PLANGO_BROWSER_VISION_ENABLED=false

# 规划视角策略：multi 按多人需要启用专业视角；single跳过这些可选角色，均使用同一集中工作流。
PLANGO_AGENT_MODE=multi

# 每次明确用户输入的预算；自动恢复和批准已有动作不补额度，累计用量保留。
PLANGO_MAX_MODEL_TOKENS=12000
PLANGO_MAX_TOOL_CALLS=48
# 单次指令允许的浏览器步数；翻页读多页时可调大。
PLANGO_MAX_BROWSER_STEPS=12
PLANGO_MAX_RUN_SECONDS=300
# 可选独立向量接口；不配置该Key时，写入和读取都不会借用聊天Key调用embedding。
# PLANGO_EMBEDDING_API_KEY=
# PLANGO_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PLANGO_EMBEDDING_MODEL=text-embedding-v4
